// mumax3: µMAG SP#1 Phase Diagram — L_c measurement
// Permalloy squares L×L×10nm, 5nm cells
// Minimize S-state and vortex init at L=120nm (near boundary), compare energies
// Default table: t, mx, my, mz  +  tableadd(E_total) → col 4

Ms    := 860e3
Aex   = 13e-12
alpha = 0.5

NL := 24  // 120nm / 5nm cells
Nz := 2   // 10nm thick

setgridsize(NL, NL, Nz)
setcellsize(5e-9, 5e-9, 5e-9)
Msat = Ms

tableadd(E_total)   // col 4: E_total (J)

// S-state init
m = uniform(1, 0.05, 0.01)
minimize()
tablesave()   // row 0: S-state energy + mx

// Vortex init
m = vortex(1, 1)
minimize()
tablesave()   // row 1: vortex energy + mx
