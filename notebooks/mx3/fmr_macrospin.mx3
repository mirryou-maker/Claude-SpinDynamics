// mumax3: FMR via Free Precession (Macrospin)
// 1×1×1 cell, B_bias=50mT along z, slightly tilted init, dt=1ps, T=5ns
// FFT of <mx>(t) → Kittel resonance frequency
// Kittel (no demag): f = gamma/(2pi) * B = 1.76e11/(2pi) * 0.05 = 1.400 GHz
// Default table: t, mx, my, mz  (col 0=t, col 1=mx)

setgridsize(1, 1, 1)
setcellsize(5e-9, 5e-9, 5e-9)

Msat  = 860e3
Aex   = 13e-12
alpha = 0.005   // very low damping -> long coherent precession -> sharp FFT peak

// Bias field along z: 50 mT
B_ext = vector(0, 0, 50e-3)

// Initial state: 5° off z-axis (small tilt to seed precession)
m = uniform(0.08716, 0.0, 0.99619)  // sin(5°), 0, cos(5°)

tableautosave(1e-12)   // 1ps time resolution -> f_max = 500 GHz, df = 0.2 GHz

FixDt = 1e-12
run(5e-9)              // 5 ns total
