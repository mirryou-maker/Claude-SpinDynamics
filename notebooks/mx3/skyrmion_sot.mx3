// SOT Skyrmion: Co/Pt 100x100x1, dx=2nm (timing only)
// Vortex init + relax + SOT drive 0.2ns via Slonczewski (mumax3 SOT proxy)
SetGridSize(100, 100, 1)
SetCellSize(2e-9, 2e-9, 1e-9)
Msat  = 800e3
Aex   = 15e-12
Ku1   = 0.8e6
AnisU = vector(0, 0, 1)
Dind  = 3e-3
alpha = 0.3
// SOT parameters (Slonczewski with in-plane polarizer)
pol          = 0.15
lambda       = 1.0
epsilonprime = 0.0
FixedLayer   = vector(1, 0, 0)
Jc := 3e12
// Vortex initial state for skyrmion seeding
m = vortex(1, 1)
setsolver(4)
FixDt = 5e-14
run(2e-10)
save(m)
