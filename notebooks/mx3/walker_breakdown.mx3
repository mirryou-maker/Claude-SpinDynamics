// mumax3: Walker Breakdown (Zhang-Li STT, Flat Strip)
// Permalloy 200×10×1 cells, dx=5nm (1µm × 50nm × 5nm)
// xi=0.5, alpha=0.05: sub-Walker (J=2e12) → v/u ≈ 8 (flat-strip shape anisotropy reduces ideal ratio 10)
// Default table: t, mx, my, mz  (col 0=t, col 1=mx)

setgridsize(200, 10, 1)
setcellsize(5e-9, 5e-9, 5e-9)

Msat  = 860e3
Aex   = 13e-12
alpha = 0.05
xi    = 0.5
pol   = 0.5

// Current: J_x = 2e12 A/m2 (sub-Walker)
j = vector(2e12, 0, 0)

// Néel DW init (core along y): mx = -tanh(x/lw), my = sech(x/lw)
lw := 5.7e-9 * pi  // π × l_ex  (approximate Néel DW width)
for ix:=0; ix<200; ix++ {
    for iy:=0; iy<10; iy++ {
        x := (ix - 100) * 5e-9
        arg := x / lw
        m.SetCell(ix, iy, 0, vector(-tanh(arg), 1.0/cosh(arg), 0))
    }
}
// mumax3 normalizes SetCell vectors automatically

tableautosave(10e-12)   // every 10ps

FixDt = 5e-14
run(5e-10)              // 0.5 ns
