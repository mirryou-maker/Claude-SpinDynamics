// muMAG Standard Problem 5 — mumax3 reference.
// 100x100x10 nm permalloy, vortex + Zhang-Li STT (J=1e12 A/m^2 +x, P=1, xi=0.05).
SetGridSize(40, 40, 2)
SetCellSize(2.5e-9, 2.5e-9, 5e-9)
Msat = 800e3
Aex  = 13e-12

alpha = 1.0
m = Vortex(1, 1)
minimize()
saveas(m, "relaxed")

alpha = 0.1
xi  = 0.05
pol = 1.0
J   = vector(1e12, 0, 0)

tableadd(ext_corepos)
tableautosave(20e-12)
run(8e-9)
